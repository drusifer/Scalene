#!/usr/bin/env bash
# Blocks a commit if gitleaks finds a secret in the staged changes.
# Installed via `make setup` (sets core.hooksPath to .githooks, and installs
# a pinned gitleaks into .venv/bin via `make install-gitleaks`).
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
if [ -x "$repo_root/.venv/bin/gitleaks" ]; then
    gitleaks="$repo_root/.venv/bin/gitleaks"
elif command -v gitleaks >/dev/null 2>&1; then
    gitleaks="$(command -v gitleaks)"
else
    echo "warning: gitleaks not installed — skipping secret scan for this commit." >&2
    echo "         run 'make install-gitleaks' to enable it." >&2
    exit 0
fi

"$gitleaks" git --staged --redact --no-banner
